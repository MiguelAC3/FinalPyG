pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build & Test') {
            steps {
                dir('pyapi') {
                    bat '.\\mvnw.cmd clean package'
                }
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                script {
                    withSonarQubeEnv('MiServidorSonar') {
                        dir('pyapi') {
                            bat '.\\mvnw.cmd sonar:sonar'
                        }
                    }
                }
            }
        }

        // ✅ NUEVO: detiene el pipeline si SonarQube falla
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        
        stage('Deploy to Tomcat') {
            steps {
                dir('pyapi') {
                    deploy adapters: [tomcat9(
                        credentialsId: 'tomcat-creds', 
                        url: 'http://localhost:8081'
                    )], 
                    war: 'target/*.war'
                }
            }
        }
    }

    // ✅ NUEVO: correos de éxito y fallo
    post {
        failure {
            emailext(
                subject: "❌ FALLIDO: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Falló en: ${env.STAGE_NAME}\nVer detalles: ${env.BUILD_URL}",
                to: 'miguelcalleparra34@gmail.com'
            )
        }
        success {
            emailext(
                subject: "✅ Deploy exitoso: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "El artefacto fue desplegado correctamente en Tomcat.",
                to: 'miguelcalleparra34@gmail.com'
            )
        }
    }
}