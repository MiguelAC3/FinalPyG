pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build & Test') {
            steps {
                dir('pyapi') {
                    bat '.\\mvnw.cmd clean package'
                }
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                script {
                    withSonarQubeEnv('MiServidorSonar') {
                        dir('pyapi') {
                            bat '.\\mvnw.cmd sonar:sonar'
                        }
                    }
                }
            }
        }
        
        stage('Deploy to Tomcat') {
            steps {
                dir('pyapi') {
                    deploy adapters: [tomcat9(credentialsId: 'tomcat-creds', url: 'http://localhost:8081')], 
                           war: 'target/*.war'
                }
            }
        }
    }
}